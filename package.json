{
  "name": "dotnet-portfolio-website",
  "version": "1.0.0",
  "private": true,
  "description": "DIWB Engineering OS - static-first interactive engineering portfolio.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run --coverage",
    "test:unit": "vitest run tests/unit tests/components",
    "test:e2e": "playwright test",
    "portfoliotool": "tsx tools/portfoliotool.ts",
    "validate:data": "tsx tools/portfoliotool.ts validate-data",
    "check:links": "tsx tools/portfoliotool.ts check-links",
    "audit:claims": "tsx tools/portfoliotool.ts audit-claims",
    "report": "tsx tools/portfoliotool.ts generate-report",
    "export:summary": "tsx tools/portfoliotool.ts export-summary",
    "verify:out": "tsx tools/verify-out.ts",
    "lighthouse": "tsx tools/lighthouse-ci.ts"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.10",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.171.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.12",
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.4",
    "jsdom": "^25.0.1",
    "lighthouse": "^13.4.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.9.0"
}
